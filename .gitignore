# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# Virtual environments
.venv/
venv/
env/
ENV/
.env
.env.*
*.env

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# ============================================================
# Data & Large Files
# ============================================================
# Raw data — should be downloaded/generated, not committed
data/raw/*.parquet
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.xls
data/raw/*.h5
data/raw/*.hdf5

# CBBI source dataset — download manually from https://cbbi.info (see README)
CBBI_dataset.xlsx

# Processed data — generated by pipeline
data/processed/*.parquet
data/processed/*.csv

# ============================================================
# Results & Trial Logs (large generated outputs)
# ============================================================
# Trial logs can be 20-50MB+ each — exclude from repo
results/trial_log/*.parquet
results/trial_log/*.csv

# Keep the summary JSON (small, valuable)
!results/optimal_params_summary.json

# ============================================================
# Analysis Outputs (keep — they are the research deliverables)
# ============================================================
# These are small and meaningful — do NOT gitignore:
# analysis/spearman_results.csv
# analysis/distribution_stats.json
# analysis/indicator_ranking.csv
# analysis/selected_indicators.json

# ============================================================
# Reports & Visualizations
# ============================================================
# Keep all .md reports and charts (they are research outputs)
# Exclude only auto-generated large temp files
*.tmp
*.log

# ============================================================
# Metadata / Fill logs (keep — useful for reproducibility)
# ============================================================
# data/metadata/fill_log.csv  — keep this

# ============================================================
# IDE & Editor
# ============================================================
.vscode/
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# ============================================================
# OS
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ============================================================
# Credentials & Secrets
# ============================================================
secrets.py
secrets.json
credentials.json
*.pem
*.key
*.p12

# ============================================================
# Testing & Coverage
# ============================================================
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# ============================================================
# Miscellaneous
# ============================================================
*.bak
*.swp
*~
